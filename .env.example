# =============================================================================
# VulnPatch 环境变量配置示例
# 复制此文件为 .env 并根据实际环境填写配置值
# =============================================================================

# ---------------------------------------------------------------------------
# LLM 大模型配置
# ---------------------------------------------------------------------------
# LLM 提供商: openai, deepseek, anthropic, gemini, ollama, qwen, glm, moonshot, doubao
#   - openai: OpenAI GPT 系列
#   - deepseek: DeepSeek 系列 (默认)
#   - anthropic: Claude 系列
#   - gemini: Google Gemini 系列
#   - ollama: 本地部署 (Llama3, Qwen2.5 等)
#   - qwen: 阿里云通义千问
#   - glm: 智谱 AI GLM 系列
#   - moonshot: Moonshot Kimi
#   - doubao: 字节跳动豆包
LLM_PROVIDER=deepseek

# LLM API 密钥 (根据提供商选择对应密钥)
# 通用密钥，当 provider 特定密钥未设置时使用
LLM_API_KEY=sk-your-api-key-here

# 各平台专用 API 密钥 (优先级高于 LLM_API_KEY)
OPENAI_API_KEY=sk-openai-key-here
DEEPSEEK_API_KEY=sk-deepseek-key-here
ANTHROPIC_API_KEY=sk-ant-api03-key-here
GEMINI_API_KEY=AIza-your-gemini-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
ZHIPU_API_KEY=your-zhipu-api-key
MOONSHOT_API_KEY=sk-your-moonshot-key
DOUBAO_API_KEY=your-doubao-api-key
OLLAMA_API_KEY=  # Ollama 通常不需要密钥

# LLM API 基础 URL（可选，用于自托管或代理）
# LLM_BASE_URL=https://api.openai.com/v1

# LLM 模型名称（可选，使用提供商默认模型）
# LLM_MODEL=deepseek-chat

# LLM 生成参数
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# 代码托管平台 Token
# ---------------------------------------------------------------------------
# GitHub 个人访问令牌（用于访问私有仓库）
GITHUB_TOKEN=

# GitLab 个人访问令牌（用于访问私有仓库）
GITLAB_TOKEN=

# Gitea 个人访问令牌（用于访问私有仓库）
GITEA_TOKEN=

# GitLab 自托管实例 URL（可选，默认 https://gitlab.com）
# GITLAB_URL=https://gitlab.com

# Gitea 自托管实例 URL（可选，默认 https://gitea.com）
# GITEA_URL=
# Autonomous model routing / competition showcase
MODEL_ROUTING_CONFIG=config/model_routing.yaml
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
# Set VULNPATCH_DB_PATH to isolate a demo/test database when desired.
# VULNPATCH_DB_PATH=data/vulnpatch-demo.db
# Competition UI can use live (real provider) or replay (explicit recorded model response).
DEMO_MODE=live
